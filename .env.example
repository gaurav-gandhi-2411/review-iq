# === LLM Providers ===
# Primary: Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Fallback: Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=AI...

# === Auth ===
# API key for write endpoints (POST /extract, /extract/batch)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your-secret-api-key-here

# === Hugging Face ===
# Write-scope token — https://huggingface.co/settings/tokens
# Only needed for deployment
HF_TOKEN=hf_...

# === App Config ===
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/review_iq.db
MAX_REVIEW_LENGTH=5000
RATE_LIMIT_PER_MINUTE=30
ENVIRONMENT=development
# Global cross-IP daily cap on POST /demo/extract -- see app/api/demo.py for the
# Groq free-tier math behind this default.
DEMO_DAILY_REQUEST_BUDGET=50

# === Alert emails (Resend) ===
# See docs/email-deliverability-runbook.md for the sandbox -> custom-domain switch.
RESEND_API_KEY=re_...
# Sandbox default. Swap to a verified custom-domain address (e.g.
# alerts@yourdomain.eu.org) once that domain is verified in Resend — no code
# change, restart only.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Samidha Reviews
# Only used while RESEND_FROM_EMAIL is the resend.dev sandbox address —
# deliveries only reach this one verified account email.
RESEND_TEST_RECIPIENT=
# Optional: where seller replies to alert emails should land.
RESEND_REPLY_TO=
# Set False to A/B test inbox placement without the leading emoji in subjects.
ALERT_SUBJECT_EMOJI_ENABLED=True

# === Unsubscribe links ===
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
UNSUBSCRIBE_SIGNING_KEY=
# Public base URL of the deployed API (e.g. https://<cloud-run-service>.run.app).
# Dev: an ngrok tunnel URL. Unsubscribe links/headers are omitted from emails
# entirely until both this and UNSUBSCRIBE_SIGNING_KEY are set.
API_PUBLIC_BASE_URL=
