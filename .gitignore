# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# uv
.uv/

# Vercel CLI project link (per-machine, per-checkout -- web/.gitignore already covers
# web/.vercel; this covers the repo-root .vercel/ that Vercel CLI also creates)
.vercel/

# Environment variables — NEVER commit
.env
.env.local
.env.*.local

# Local dev secrets / one-shot provisioning helpers — NEVER commit or ship in build context
_devkey.txt
_provision_key.py
drafts/

# Database files
*.db
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Type checking
.mypy_cache/

# Linting
.ruff_cache/

# Logs
logs/
*.log

# Model outputs / large artifacts
outputs/
*.pkl
*.bin
*.onnx

# Jupyter
.ipynb_checkpoints/

# HF / Docker build artifacts

# Claude Code
.claude/

# Web frontend local env — contains real Supabase/API keys
web/.env.local

# Terraform — provider cache and state (state must stay local or in GCS backend). Glob, not
# exact filenames -- moving the killswitch between projects produces per-project copies by
# hand (terraform.tfstate.review-iq-prod.bak etc.) that matched neither exact name and sat
# untracked AND unignored, one `git add -A` away from committing infra state into a public
# repo. This glob covers the live state, its .backup, and any hand-made per-project copy.
ops/budget-killswitch/.terraform/
ops/budget-killswitch/*.tfstate*
ops/budget-killswitch/.build/

# Cloudflare Wrangler local cache (demo deploy tooling) — build artifact, not source
.wrangler/

# Local scratch/raw datasets for prompt-tuning work (large Kaggle downloads + derived
# intermediates) — mirrors eval/data/.gitignore's raw/generated-candidate exclusion pattern.
/data/
